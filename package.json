{
  "name": "simple-gym-beta",
  "version": "2.1.4",
  "engines": {
    "node": "24.x"
  },
  "description": "Dan Buda's Simple Workout App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:fix": "stylelint \"src/**/*.css\" --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "pnpm format:check && pnpm lint && pnpm stylelint && pnpm build",
    "prepare": "husky"
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{html,json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "Dan Buda",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanBuda11/simple-gym-beta"
  },
  "license": "ISC",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "devDependencies": {
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.8.1",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended": "^18.0.0",
    "vite": "^8.1.5"
  }
}
